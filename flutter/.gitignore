app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Device-derived skin packs (Flat-Pack, Marbles, Transfer Ring) are patent-
# sensitive and must never be committed here. The source of truth is a
# wapex-only repo; drop the directory in, run tool/gen_skin_registry.sh, build.
# See lib/skin/README.md.
/lib/skin/packs_private/
# ...and the tests/renders that go with them: they import the packs, so they
# would not compile in a clone that has no packs_private/.
/test/packs_private/
